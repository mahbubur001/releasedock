// Shared build settings. Machine- or publisher-specific values go in Config/Local.xcconfig
// (git-ignored); see DEVELOPMENT.md.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Sparkle appcast URL (HTTPS; write https:/$()/host/path in xcconfig) and EdDSA public key.
// The public key is not secret; the matching private key lives in the publisher's login
// Keychain (Sparkle generate_keys) and signs every update.
// Leave either empty and in-app updates stay disabled: ReleaseDock never starts Sparkle
// without a feed and signature verification configured.
SPARKLE_FEED_URL = https:/$()/raw.githubusercontent.com/mahbubur001/releasedock/main/updates/appcast.xml
SPARKLE_PUBLIC_ED_KEY = IQpqkpmmXFC+4GmForq8pIK2ua4ocBfXeWp5wLem6W8=

// GitHub repository checked for new releases, as owner/name. Users can override it in Settings.
RELEASEDOCK_GITHUB_REPOSITORY = mahbubur001/releasedock

#include? "Local.xcconfig"
